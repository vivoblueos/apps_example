import("//build/templates/blueos_app_bundle.gni")
import("//build/templates/blueos_dso.gni")

# The GN build graph must stay acyclic, but the ELF closure may not: this
# stub carries libcycle_a's SONAME so libcycle_b can record its back-edge
# DT_NEEDED before the real libcycle_a (which links back against b) exists.
blueos_dso("cycle_a_bootstrap") {
  crate_name = "cycle_a_bootstrap"
  soname = "libcycle_a.so.1"
  sources = [ "bootstrap/lib.rs" ]
  deps = [ "//librs:libc" ]
  _lib_dir = rebase_path("${root_out_dir}/lib")
  rustflags = [
    "-Clink-arg=-L${_lib_dir}",
    "-Clink-arg=-l:liblibrs.so",
  ]
}

# private-cycle corpus: the runtime closure
# contains a real private cycle — libcycle_a and libcycle_b each declare the
# other — so the loader must freeze one SCC with a stable discovery order,
# initialize it dependency-first, and run the fini in the exact reverse.

blueos_app_bundle("cycle_demo") {
  root_path = "/apps/cycle_demo/app.elf"
  root_sources = [ "app/main.rs" ]
  root_depends = [
    "libcycle_a",
    "libcycle_b",
  ]
  private_dsos = [
    {
      name = "libcommon"
      soname = "libcommon.so.1"
      vfs_path = "/apps/cycle_demo/lib/libcommon.so.1"
      sources = [ "libcommon/lib.rs" ]
      depends = []
    },
    {
      name = "libcycle_a"
      soname = "libcycle_a.so.1"
      vfs_path = "/apps/cycle_demo/lib/libcycle_a.so.1"
      sources = [ "libcycle_a/lib.rs" ]
      depends = [
        "libcycle_b",
        "libcommon",
      ]
    },
    {
      name = "libcycle_b"
      soname = "libcycle_b.so.1"
      vfs_path = "/apps/cycle_demo/lib/libcycle_b.so.1"
      sources = [ "libcycle_b/lib.rs" ]

      # The back edge links against the bootstrap stub (same SONAME): GN
      # stays acyclic while the DT_NEEDED cycle closes at the ELF level.
      depends = [
        "cycle_a_bootstrap",
        "libcommon",
      ]
    },
  ]
}
