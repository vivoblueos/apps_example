import("//build/templates/dynamic_app.gni")

# fixture: the minimal Thumb PIE dynamic application. It links
# `blueos_scrt1` as its start object and imports the shared libc through the
# `libc.so.1` DSO (the linker records `DT_NEEDED: libc.so.1` from the SONAME),
# so the kernel loader's dependency closure pulls in `libc.so.1` at launch.
#
# The dynamic-app template supplies the board's Thumb link policy.
dynamic_app("hello") {
  sources = [ "src/main.rs" ]
  start_object = "//librs:blueos_scrt1"
  deps = [
    "//librs:blueos_scrt1",
    "//librs:libc",
  ]
  _lib_dir = rebase_path("${root_out_dir}/lib")
  rustflags = [
    "-Clink-arg=-L${_lib_dir}",
    "-Clink-arg=-l:liblibrs.so",

    # scrt1 resolves `main` through its GOT slot; export the symbol so the
    # linker emits the R_ARM_GLOB_DAT that the kernel loader fills at load time.
    "-Clink-arg=-Wl,--export-dynamic-symbol=main",
  ]
}
