import("//build/templates/blueos_app_bundle.gni")

# emutls corpus: two private DSOs each define a same-named
# `thread_local` counter — every `__emutls_get_address` reference must resolve
# to the unique system libc, the control objects stay per-image, and two
# application threads with different loop counts must observe fully isolated
# per-thread values. The root repeats the create/join cycle to exercise
# per-thread destructor paths.

blueos_app_bundle("tls_demo") {
  root_path = "/apps/tls_demo/app.elf"
  root_sources = [ "app/main.rs" ]
  root_depends = [
    "libfoo",
    "libbar",
  ]
  private_dsos = [
    {
      name = "libfoo"
      soname = "libfoo.so.1"
      vfs_path = "/apps/tls_demo/lib/libfoo.so.1"
      sources = [ "libfoo/lib.rs" ]
      depends = []
      rustflags = [ "-Clink-arg=-Wl,--pic-veneer" ]
    },
    {
      name = "libbar"
      soname = "libbar.so.1"
      vfs_path = "/apps/tls_demo/lib/libbar.so.1"
      sources = [ "libbar/lib.rs" ]
      depends = []
      rustflags = [ "-Clink-arg=-Wl,--pic-veneer" ]
    },
  ]
}
