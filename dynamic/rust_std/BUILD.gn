import("//build/templates/dynamic_app.gni")

# A Rust `std` PIE. `std` is linked statically into the image; the only dynamic
# dependency is the shared `libc.so.1`, exactly as for the C and C++ fixtures.
#
# app.elf -> libc.so.1
#
# The point of the fixture is std's own runtime, not the ELF contract: the C and
# C++ fixtures already cover that. `std` reaches `libc.so.1` for `malloc`,
# `calloc`, `realloc`, `memalign`, `abort`, the pthread primitives and `write`.
dynamic_app("rust_std") {
  sources = [ "src/main.rs" ]
  start_object = "//librs:blueos_scrt1"
  deps = [
    "//libc",
    "//librs:blueos_scrt1",
    "//librs:libc",
  ]
  _lib_dir = rebase_path("${root_out_dir}/lib")
  rustflags = [
    "-Clink-arg=-L${_lib_dir}",
    "-Clink-arg=-l:liblibrs.so",
    "-Clink-arg=-Wl,--export-dynamic-symbol=main",
  ]
}

group("rust_std_all") {
  deps = [ ":rust_std_check" ]
}
