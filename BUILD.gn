import("//build/templates/rust.gni")
import("//build/toolchain/blueos.gni")

group("check_apps") {
  deps = [
    "//apps/example/blinky:blinky_example",
    "//apps/example/fs:fs_example",
    "//apps/example/ftp_client:ftp_client_example_test_runner",
    "//apps/example/net:net_example",
    "//apps/example/no_std:no_std_example_runner",
  ]
  if (board == "qemu_mps2_an385") {
    deps += [
      "//apps/example/dynamic/clang_c",
      "//apps/example/dynamic/clang_cxx",
      "//apps/example/dynamic/cycle_demo",
      "//apps/example/dynamic/multi_dso:multi",
      "//apps/example/dynamic/rust_std:rust_std_all",
      "//apps/example/dynamic/scope_bad",
      "//apps/example/dynamic/scope_demo",
      "//apps/example/dynamic/tls_demo",
    ]
  }
}
